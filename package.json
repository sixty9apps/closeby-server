    "express-rate-limit": "^5.0.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "joi": "^18.0.2",
    "mongoose": "^9.1.2",
    "passport": "^0.7.0",
    "pm2": "^6.0.14",
    "serverless-http": "^4.0.0",
    "validator": "^13.0.0",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "coveralls": "^3.0.7",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "faker": "^6.6.6",
    "husky": "9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "node-mocks-http": "^1.8.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "supertest": "^7.2.2"
